# =====================================================================
# BRAINOVA NATIONAL OLYMPIAD - CLIENT PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to `.env` on the client's server and update the values.
# =====================================================================

PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_64_char_string

# MASTER ADMIN CREDENTIALS (Default Master Admin Login)
ADMIN_USER=admin@brainova.com
ADMIN_PASSWORD=Admin@Brainova2026

# =====================================================================
# DATABASE ADAPTER CONFIGURATION
# Options: 'sqlite' | 'mysql' | 'postgres'
# =====================================================================
DB_CLIENT=mysql

# --- Option 1: MySQL / MariaDB (Recommended for cPanel / VPS / RDS) ---
# If using cPanel, create a database in MySQL Database Wizard, add a user with ALL PRIVILEGES,
# and import db/schema.sql in phpMyAdmin.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=brainova_dbuser
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=brainova_olympiad

# --- Option 2: PostgreSQL / Supabase ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DATABASE=brainova_olympiad
PG_SSL=false
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Option 3: SQLite (Embedded zero-configuration file) ---
# Set DB_CLIENT=sqlite to run without any external database server.

# =====================================================================
# EMAIL & NOTIFICATION DISPATCHER SETTINGS
# =====================================================================
ADMIN_NOTIFICATION_EMAIL=admin@brainova.com

# Service type: 'gmail' or 'smtp' (Brevo, SendGrid, Hostinger, cPanel Webmail)
EMAIL_SERVICE=smtp
EMAIL_USER=notifications@yourdomain.com
EMAIL_PASS=your_email_or_app_password

# Custom SMTP Host & Port (required if EMAIL_SERVICE=smtp)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender Identity
EMAIL_FROM_NAME="Brainova National Olympiad"
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
