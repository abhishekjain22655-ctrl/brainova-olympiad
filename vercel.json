{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/user/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/student-registration-submit.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/school-registration-submit.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/inquiry-submit.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/contact-submit.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/newsletters.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
